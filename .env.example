# Copy this to .env for local development. DO NOT commit .env (it is git-ignored).
# For production, values live in .env.production (committed, used by `vite build`).

# Local dev backend (Vite will proxy /api/* here so the browser never hits the URL directly)
VITE_BACKEND_API_URL=http://localhost:3001

# External Sochiot engines — usually point to prod even in dev
VITE_EXTERNAL_API_URL=https://app.sochiot.com/api/auth-engine
VITE_CONFIG_API_URL=https://app.sochiot.com/api/config-engine
VITE_RULE_ENGINE_API=https://app.sochiot.com/api/rule-engine/apply
