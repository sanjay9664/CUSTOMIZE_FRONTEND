# BMS Backend API Base Path (Single Source of Truth)
VITE_BACKEND_API_URL=/api/v1

# Opt-in Development Mock API (Must be false in production)
VITE_USE_MOCK_API=false

# External Engines (Optional)
VITE_EXTERNAL_API_URL=/sochiot-auth
VITE_CONFIG_API_URL=/sochiot-config
VITE_RULE_ENGINE_API=/sochiot-triggers
